            highp vec4 vs_INTERP0;\nvarying highp vec4 vs_INTERP1;\n#define SV_TARGET0
            gl_FragData[0]\nvec4 u_xlat0;\nlowp vec4 u_xlat10_0;\nvec3 u_xlat1;\nlowp
