            u_xlat11.xy + vec2(0.5, 0.5);\n            u_xlat3.x = dot(u_xlat11.xy,
            u_xlat11.xy);\n            u_xlat3.x = sqrt(u_xlat3.x);\n           
            u_xlatb11 = u_xlat3.x<u_xlat17.y;\n            u_xlat17.xy = (bool(u_xlatb11))
            ? u_xlat3.xx : u_xlat17.xy;\n        }\n        u_xlat16.xy = u_xlat17.xy;\n   
            }\n    u_xlat1.x = _TimeParameters.x * _DistortionOffsetSpeed;\n    u_xlat8.xy
            = _DistortionDir.xy * _TimeParameters.xx + vs_INTERP0.xy;\n    u_xlat8.xy
            = u_xlat8.xy * vec2(_DistortionScale);\n    u_xlat2.xy = floor(u_xlat8.xy);\n   
            u_xlat8.xy = fract(u_xlat8.xy);\n    u_xlat3.x = float(0.0);\n    u_xlat3.y
