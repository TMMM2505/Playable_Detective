            { return int(floor(float(a) / pow(2.0, float(b)))); }\nivec2 op_shr(ivec2
            a, ivec2 b) { a.x = op_shr(a.x, b.x); a.y = op_shr(a.y, b.y); return
            a; }\nivec3 op_shr(ivec3 a, ivec3 b) { a.x = op_shr(a.x, b.x); a.y =
            op_shr(a.y, b.y); a.z = op_shr(a.z, b.z); return a; }\nivec4 op_shr(ivec4
            a, ivec4 b) { a.x = op_shr(a.x, b.x); a.y = op_shr(a.y, b.y); a.z = op_shr(a.z,
            b.z); a.w = op_shr(a.w, b.w); return a; }\n\nint op_shl(int a, int b)
