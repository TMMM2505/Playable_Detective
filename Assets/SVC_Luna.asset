            = u_xlati18.x + u_xlati11.x;\n            u_xlati11.x = u_xlati18.x *
            u_xlati11.x;\n            u_xlati25 = op_shr(u_xlati11.x, 5);\n           
            u_xlati11.x = op_xor(u_xlati25, u_xlati11.x);\n            u_xlati5.y
            = u_xlati11.x * 668265261;\n            u_xlati11.x = op_shl(u_xlati5.y,
            3);\n            u_xlati5.x = op_xor(u_xlati11.x, u_xlati18.x);\n           
            u_xlati11.xy = op_shr(u_xlati5.xy, ivec2(8, 8));\n            u_xlat11.xy
            = vec2(u_xlati11.xy);\n            u_xlat11.xy = u_xlat1.zz * u_xlat11.xy;\n           
            u_xlat11.xy = u_xlat11.xy * vec2(5.96046519e-08, 5.96046519e-08);\n           
            u_xlat5.x = sin(u_xlat11.x);\n            u_xlat5.y = cos(u_xlat11.y);\n           
            u_xlat11.xy = u_xlat5.xy * vec2(0.5, 0.5) + u_xlat3.xy;\n           
